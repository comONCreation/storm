        "meta.function-call support.function"
      ],
      "settings": {
        "foreground": "#BCBEC4"
      }
    },
    {
      "scope": [
        "meta.method-call entity.name.function",
        "meta.method-call.php entity.name.function",
        "meta.function-call.object entity.name.function",
