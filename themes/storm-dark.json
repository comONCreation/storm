  "tokenColors": [
    {
      "scope": [
        "source",
        "text",
        "meta.embedded",
        "punctuation",
        "keyword.operator",
        "meta.brace",
        "variable",
        "variable.other",
        "meta.function-call",
        "meta.method-call",
        "support.function",
        "entity.name.namespace",
        "support.other.namespace",
        "entity.name.type.namespace"
      ],
      "settings": {
        "foreground": "#BCBEC4"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.class",
        "entity.other.inherited-class",
        "support.type"
      ],
      "settings": {
        "foreground": "#BCBEC4"
      }
    },
    {
      "scope": [
        "entity.name.type.enum",
        "entity.name.type.struct"
      ],
      "settings": {
        "foreground": "#BCBEC4"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.other",
        "storage",
        "storage.type",
        "storage.modifier",
        "constant.language",
        "variable.language",
        "variable.language.this",
        "support.type.primitive",
        "keyword.type",
        "keyword.other.type",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.type",
        "keyword.operator.instanceof",
        "keyword.operator.logical.python",
        "keyword.other.use",
        "keyword.other.namespace",
        "meta.directive.blade keyword",
        "keyword.blade"
      ],
      "settings": {
        "foreground": "#CF8E6D"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "string.regexp",
        "punctuation.definition.string",
        "string.unquoted.heredoc",
        "string.unquoted.nowdoc"
      ],
      "settings": {
        "foreground": "#6AAB73"
      }
    },
    {
      "scope": [
        "constant.character.escape",
        "constant.character"
      ],
      "settings": {
        "foreground": "#CF8E6D"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "keyword.other.unit"
      ],
      "settings": {
        "foreground": "#2AACB8"
      }
    },
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#7A7E85",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "comment.block.documentation",
        "comment.block.documentation punctuation.definition.comment",
        "comment.block.javadoc"
      ],
      "settings": {
        "foreground": "#5F826B",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "comment.block.documentation keyword",
        "comment.block.documentation storage.type",
        "keyword.other.phpdoc",
        "storage.type.class.jsdoc",
        "storage.type.class.phpdoc",
        "comment.block.documentation entity.name.tag"
      ],
      "settings": {
        "foreground": "#67A37C",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "comment.block.documentation entity.name.type",
        "comment.block.documentation support.class",
        "comment.block.documentation variable",
        "comment.block.documentation keyword.other.type"
      ],
      "settings": {
        "foreground": "#ABADB3",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "meta.function entity.name.function",
        "meta.definition.method entity.name.function",
        "meta.definition.function entity.name.function",
        "meta.method.declaration entity.name.function"
      ],
      "settings": {
        "foreground": "#56A8F5"
      }
    },
    {
      "scope": [
        "support.function.constructor.php",
        "meta.function.php support.function.constructor.php"
      ],
      "settings": {
        "foreground": "#56A8F5"
      }
    },
    {
      "scope": [
        "meta.function-call entity.name.function",
        "meta.function-call.php entity.name.function",
